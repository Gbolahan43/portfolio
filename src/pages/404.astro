---
import Layout from '~/layouts/Layout.astro';
---

<Layout title="404 — Page Not Found" description="The page you're looking for doesn't exist.">
  <main class="main container" style="min-height: 80vh; display: flex; flex-direction: column; justify-content: center; align-items: flex-start;">
    <h1 class="h1">404</h1>
    <p class="p" style="margin-top: 1rem; margin-bottom: 2rem; color: var(--fg-subtle);">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a href="/portfolio/" class="btn" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; padding: 0.5rem 1rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--fg); font-weight: 500; transition: border-color var(--dur-fast) ease;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Go back home
    </a>
  </main>
</Layout>
