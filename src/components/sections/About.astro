---
/**
 * §05 About — portrait (left) + prose (right), then a credentials strip.
 * Portrait is here only, never in the hero (R-24).
 * Square crop, --radius-md, 1:1, 320px desktop / capped 280px mobile.
 * Credentials are a scannable strip (label + dot-separated line), not a badge
 * wall — same restraint as skipping GitHub stats widgets.
 * Per wireframes §7.8 and content-inventory §5.
 */
import type { SectionData, CredentialsData } from '~/data/portfolio';

interface Props {
  portrait: { src: string; alt: string };
  paragraphs: string[];
  credentials: CredentialsData;
  section: SectionData;
}

const { portrait, paragraphs, credentials, section } = Astro.props;
---

<section class="section container" id={section.id} aria-labelledby={`${section.id}-h`} data-od-id={`section-${section.id}`}>
  <div class="section__head">
    <p class="caption section__num"><span aria-hidden="true">{section.num}</span></p>
    <h2 class="label section__name" id={`${section.id}-h`}>{section.name}</h2>
  </div>
  <div class="section__body">
    <div class="split reveal">
      <div class="portrait" data-shot data-od-id="about-portrait">
        <img
          src={portrait.src}
          alt={portrait.alt}
          width="640"
          height="640"
          loading="lazy"
          decoding="async"
        />
        <span class="portrait__ph">
          <span class="caption">Portrait</span>
          <span class="caption" style="letter-spacing:.04em;text-transform:none">1:1 · high-contrast · cool-neutral grade</span>
        </span>
      </div>
      <div class="about">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <dl class="creds reveal" data-od-id="about-credentials">
      {credentials.groups.map((g) => (
        <div class="creds__row">
          <dt class="label creds__label">{g.label}</dt>
          <dd class="creds__items">{g.items.join(' · ')}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
