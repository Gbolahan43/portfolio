---
/**
 * Sticky navigation — appears after 80px scroll.
 * Left: wordmark (full name / AO initials on mobile).
 * Right: Work · Thinking · About → theme toggle → Résumé CTA pair.
 * On mobile: wordmark collapses to initials, section anchors removed.
 * Per design-system-spec §10.8 and accessibility §12.4.
 */
import type { ResumeCta } from '~/data/portfolio';
import ResumeControls from '../ui/ResumeControls.astro';

interface NavLink {
  name: string;
  href: string;
}

interface Props {
  navLinks: NavLink[];
  resume: ResumeCta;
}

const { navLinks, resume } = Astro.props;
---

<header class="nav" id="site-nav" data-od-id="site-nav">
  <div class="nav__inner container">
    <a class="wordmark" href="#top" data-od-id="nav-wordmark">
      <span class="wordmark__full">Abdulbasit Olanrewaju</span>
      <span class="wordmark__short">AO</span>
    </a>

    <nav class="nav__links" aria-label="Sections" data-od-id="nav-links">
      {navLinks.map((link) => (
        <a href={link.href}>{link.name}</a>
      ))}
    </nav>

    <div class="nav__actions">
      <button
        class="toggle"
        id="theme-toggle"
        type="button"
        aria-pressed="false"
        aria-label="Switch to dark theme"
        data-od-id="theme-toggle"
      >
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4"/></svg>
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z"/></svg>
      </button>

      <span class="cv" data-od-id="nav-resume">
        <ResumeControls resume={resume} />
      </span>
    </div>
  </div>
</header>
