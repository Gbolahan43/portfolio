---
/**
 * Icon component — renders exact SVG markup from the approved design.
 * Stroke: 1.75px for most icons; 2px for arrow-up-right and check.
 * Some icons (moon, copy) are custom — preserved for fidelity.
 * Uses inline conditional rendering (reliable in Astro SSR; set:html/@html on SVG is unreliable).
 */
interface Props {
  name: 'arrow-up-right' | 'download' | 'chevron-down' | 'copy' | 'check' | 'sun' | 'moon';
  class?: string;
  ['aria-hidden']?: boolean;
}

const { name, class: className = '', 'aria-hidden': ariaHidden = true } = Astro.props;
const ariaHiddenAttr = ariaHidden === false ? null : { 'aria-hidden': 'true' };
---
{
  name === 'arrow-up-right' && (
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} {...ariaHiddenAttr}>
      <path d="M7 17L17 7M17 7H9M17 7v8" />
    </svg>
  )
}
{
  name === 'download' && (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} {...ariaHiddenAttr}>
      <path d="M12 4v10m0 0l-3.5-3.5M12 14l3.5-3.5M5 18h14" />
    </svg>
  )
}
{
  name === 'chevron-down' && (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} {...ariaHiddenAttr}>
      <path d="M6 9.5l6 6 6-6" />
    </svg>
  )
}
{
  name === 'copy' && (
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} {...ariaHiddenAttr}>
      <rect x="9" y="9" width="11" height="11" rx="2.5" />
      <path d="M15 5.5A2.5 2.5 0 0 1 12.5 3h-6A3.5 3.5 0 0 0 3 6.5v6A2.5 2.5 0 0 0 5.5 15h11a2.5 2.5 0 0 0 2.5-2.5v-6A3.5 3.5 0 0 1 12.5 3h-6" />
    </svg>
  )
}
{
  name === 'check' && (
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} {...ariaHiddenAttr}>
      <path d="M4.5 12.5l5 5 10-11" />
    </svg>
  )
}
{
  name === 'sun' && (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class={className} {...ariaHiddenAttr}>
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4" />
    </svg>
  )
}
{
  name === 'moon' && (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} {...ariaHiddenAttr}>
      <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 0 0 10.5 10.5z" />
    </svg>
  )
}
