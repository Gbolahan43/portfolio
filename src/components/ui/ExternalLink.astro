---
/**
 * External link with outbound glyph and screen-reader prefix.
 * Missing href → plain muted text (never a dead link, never href="#")
 * Per design-system-spec §10.7 and accessibility-and-rationale R-23.
 */
import type { Link } from '~/data/portfolio';
import Icon from './Icon.astro';

interface Props {
  link: Link;
  class?: string;
}

const { link, class: className = '' } = Astro.props;
---

{link.href ? (
  <a
    class={`ext ${className}`.trim()}
    href={link.href}
    target="_blank"
    rel="noopener noreferrer"
  >
    {link.label}
    <Icon name="arrow-up-right" width={12} height={12} strokeWidth={2} />
    <span class="sr">(opens in a new tab)</span>
  </a>
) : (
  <span class={`pending ${className}`.trim()}>{link.label.toLowerCase()} pending</span>
)}
